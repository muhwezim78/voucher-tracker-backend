# ===========================================
# Voucher Tracker Backend - Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voucher_system
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# MikroTik Router Configuration
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=your_mikrotik_password_here

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Security Keys (CHANGE THESE IN PRODUCTION!)
APP_SECRET_KEY=generate-a-secure-random-string-here
JWT_SECRET_KEY=generate-another-secure-random-string-here
ENCRYPTION_KEY=generate-32-byte-encryption-key-here

# JWT Settings
JWT_EXPIRY_HOURS=24
SESSION_TIMEOUT_HOURS=1
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Twilio SMS Configuration (Optional)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Admin Login (for special_login route)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2:sha256:your_hashed_password
